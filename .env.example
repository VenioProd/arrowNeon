# ==========================================================================
# Configuration backend formulaires — NEON GRID / Arrow
# Copier ce fichier en `.env` puis renseigner les valeurs réelles.
# `.env` est ignoré par git (voir .gitignore) — n'y mettez jamais de secret
# dans le dépôt.
# ==========================================================================

# --- Destinataire / expéditeur ---
# Adresse qui RECOIT les demandes de contact / inscription.
CONTACT_TO=contact@arrow.example
# Adresse affichée comme expéditeur (souvent identique au compte SMTP).
CONTACT_FROM=noreply@arrow.example

# --- Serveur SMTP sortant ---
# Renseignez ces variables pour activer l'envoi réel.
# Tant que CONTACT_SMTP_HOST est vide, le backend tourne en mode "dry-run"
# si CONTACT_DRY_RUN=1 (les messages sont journalisés mais pas envoyés).
CONTACT_SMTP_HOST=
CONTACT_SMTP_PORT=587
# true pour le port 465 (SSL implicite), false pour 587 (STARTTLS).
CONTACT_SMTP_SECURE=false
CONTACT_SMTP_USER=
CONTACT_SMTP_PASS=

# --- Mode dry-run (dev) ---
# 1 = ne pas envoyer réellement, journaliser le message et répondre OK.
# Pratique en local sans compte SMTP. Mettre à 0/absent en production.
CONTACT_DRY_RUN=1

# --- CORS ---
# Origine(s) autorisée(s) pour les requêtes depuis le navigateur.
# "*" convient pour un prototype mono-domaine ; en production, fixez la/les
# URL(s) exacte(s), séparées par des virgules (ex: https://arrow.example,https://www.arrow.example).
# Avec une allowlist, le serveur ne renvoie jamais "*" : il reflète l'origine reçue si elle correspond.
CONTACT_ALLOWED_ORIGIN=*

# --- Proxy de confiance ---
# 1 = se fier à l'en-tête X-Forwarded-For pour identifier l'IP cliente (rate-limit).
# À n'activer QUE si le service est derrière un reverse-proxy de confiance
# (Traefik, Nginx, Vercel…). Sinon l'en-tête est usurpable.
TRUST_PROXY=0

# --- Serveur statique local (server.js uniquement) ---
PORT=3000
