---
import BaseLayout from '../layouts/BaseLayout.astro'
import FicheEtudiant from '../components/mock/FicheEtudiant.astro'
import { testimonials, clientLogos } from '../data/testimonials'

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Arrow',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  description:
    "Arrow centralise les absences, les notes, les bulletins, les documents et les preuves de suivi dans un espace plus clair pour les équipes pédagogiques et scolarité.",
  offers: {
    '@type': 'Offer',
    availability: 'https://schema.org/LimitedAvailability',
    category: 'Beta',
  },
}
---
<BaseLayout
  title="Arrow — Le suivi étudiant plus clair"
  description="Arrow centralise absences, notes, bulletins, documents et commentaires utiles dans un espace plus clair pour les équipes pédagogiques et scolarité."
  activePage="accueil"
  jsonLd={jsonLd}
>
  <link rel="stylesheet" href="/styles/pages/index.css" slot="head">

  <div class="main-container home-page">
    <section class="hero">
      <div class="hero__inner">
        <div class="hero__copy">
          <p class="hero__eyebrow">Écoles sup · CFA · équipes scolarité</p>
          <h1 class="hero__title">Chaque étudiant,<br><span class="hero__hl">une seule vue</span> claire.</h1>
          <p class="hero__lede">Absences, notes, bulletins, documents et commentaires réunis par étudiant. Repérez qui décroche, justifiez en un clic, décidez sans multiplier les exports.</p>
          <div class="hero__ctas">
            <a href="/contact" data-open-modal="betaAccessModal" class="btn-primary" data-track="home_demo">Demander une démo</a>
            <a href="#difference" class="btn-ghost" data-track="home_difference">Voir une fiche étudiant</a>
          </div>
          <ul class="hero__trust">
            <li>RGPD &amp; hébergement FR</li>
            <li>Mise en route &lt; 1 jour</li>
          </ul>
        </div>
        <div class="hero__visual">
          <FicheEtudiant />
        </div>
      </div>
    </section>

    <div class="hud-stats">
      <div class="stat-item">
        <div class="stat-value">1 fiche</div>
        <div class="stat-label">par étudiant</div>
      </div>
      <div class="stat-item">
        <div class="stat-value">Moins</div>
        <div class="stat-label">d'exports dispersés</div>
      </div>
      <div class="stat-item">
        <div class="stat-value">Suivi</div>
        <div class="stat-label">partagé par l'équipe</div>
      </div>
    </div>

    <section class="problem-section" id="difference">
      <div class="problem-head">
        <p class="problem-eyebrow">Le problème</p>
        <h2 class="problem-title">Vos infos étudiants sont éclatées dans 5 outils.</h2>
        <p class="problem-subtitle">Arrow les réunit dans une seule vue par étudiant — absences, notes, bulletins et documents au même endroit.</p>
      </div>

      <div class="problem-contrast">
        <div class="problem-before" aria-label="Aujourd'hui : informations dispersées">
          <span class="problem-side-label">Aujourd'hui — dispersé</span>
          <div class="scatter">
            <span class="scatter-chip">Tableur</span>
            <span class="scatter-chip">Emails</span>
            <span class="scatter-chip">Module absences</span>
            <span class="scatter-chip">PDF bulletins</span>
            <span class="scatter-chip">Notes</span>
          </div>
        </div>

        <div class="problem-arrow" aria-hidden="true">
          <svg viewBox="0 0 48 24" focusable="false" width="48" height="24">
            <path d="M2 12h40M34 4l8 8-8 8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>

        <div class="problem-after" aria-label="Avec Arrow : une seule fiche étudiant">
          <span class="problem-side-label problem-side-label--accent">Avec Arrow — réuni</span>
          <FicheEtudiant />
        </div>
      </div>

      <div class="brutal-entry">
        <p class="brutal-entry__lead">Vous reconnaissez ces irritants dans votre suivi actuel ?</p>
        <button type="button" class="brutal-mode-cta" data-open-modal="brutalModeModal" data-track="home_brutal_mode">
          <span class="brutal-cta-text">Voir les irritants fréquents</span>
          <span class="brutal-cta-icon">↗</span>
        </button>
      </div>
    </section>

    <section class="home-section-head home-section-head--compact">
      <p class="eyebrow">Positionnement</p>
      <h2>Pensé pour les équipes qui doivent suivre, prouver et décider.</h2>
      <p>
        Arrow aide les établissements qui doivent retrouver vite une absence, préparer un bulletin,
        documenter un échange ou partager une preuve fiable autour du parcours étudiant.
      </p>
    </section>

    <div class="cyber-grid cyber-grid--compact">
      <div class="cyber-card cyber-card--student">
        <div class="cyber-icon">
          <svg width="64" height="64" viewBox="0 0 64 64" fill="none" aria-hidden="true">
            <rect x="14" y="14" width="36" height="36" rx="12" stroke="currentColor" stroke-width="1.8"/>
            <circle cx="32" cy="27" r="6" stroke="currentColor" stroke-width="1.8"/>
            <path d="M22 43C24.2 37.8 28 35 32 35C36 35 39.8 37.8 42 43" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
          </svg>
        </div>
        <h3 class="cyber-title">FICHE ÉTUDIANT</h3>
        <p class="cyber-desc">Absences, notes, documents et historique dans une même lecture.</p>
      </div>

      <div class="cyber-card cyber-card--attendance">
        <div class="cyber-icon">
          <svg width="64" height="64" viewBox="0 0 64 64" fill="none" aria-hidden="true">
            <path d="M18 42L26 34L31 39L44 24" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M18 20H46" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" opacity="0.45"/>
            <path d="M18 28H34" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" opacity="0.45"/>
            <circle cx="44" cy="24" r="4" fill="currentColor"/>
          </svg>
        </div>
        <h3 class="cyber-title">ABSENCES</h3>
        <p class="cyber-desc">Alertes et assiduité lisibles sans changer de fenêtre.</p>
      </div>

      <div class="cyber-card cyber-card--results">
        <div class="cyber-icon">
          <svg width="64" height="64" viewBox="0 0 64 64" fill="none" aria-hidden="true">
            <rect x="18" y="14" width="24" height="30" rx="6" stroke="currentColor" stroke-width="1.8"/>
            <path d="M24 24H36" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            <path d="M24 31H36" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" opacity="0.55"/>
            <path d="M24 38H32" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" opacity="0.55"/>
            <path d="M42 21L46 25L42 29" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <h3 class="cyber-title">NOTES & BULLETINS</h3>
        <p class="cyber-desc">Résultats, évaluations et bulletins reliés plus clairement.</p>
      </div>

      <div class="cyber-card cyber-card--documents">
        <div class="cyber-icon">
          <svg width="64" height="64" viewBox="0 0 64 64" fill="none" aria-hidden="true">
            <path d="M18 24C18 20.6863 20.6863 18 24 18H30L34 22H40C43.3137 22 46 24.6863 46 28V40C46 43.3137 43.3137 46 40 46H24C20.6863 46 18 43.3137 18 40V24Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
            <path d="M27 33L31 37L38 29" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <h3 class="cyber-title">DOCUMENTS & PREUVES</h3>
        <p class="cyber-desc">Pièces, commentaires et preuves utiles retrouvés plus vite.</p>
      </div>
    </div>

    {(testimonials.length > 0 || clientLogos.length > 0) && (
      <section class="social-proof">
        <div class="home-section-head home-section-head--compact">
          <p class="eyebrow">Ils utilisent Arrow</p>
          <h2>Ce que disent les équipes sur le terrain.</h2>
        </div>

        {testimonials.length > 0 && (
          <div class="testimonial-grid">
            {testimonials.map((item) => (
              <figure class="testimonial-card card">
                <blockquote class="testimonial-quote">“{item.quote}”</blockquote>
                <figcaption class="testimonial-author">
                  <span class="testimonial-name">{item.author}</span>
                  <span class="testimonial-role">{item.role}</span>
                </figcaption>
              </figure>
            ))}
          </div>
        )}

        {clientLogos.length > 0 && (
          <div class="client-logos" aria-label="Établissements qui utilisent Arrow">
            {clientLogos.map((logo) => (
              <img class="client-logo" src={logo.src} alt={logo.name} loading="lazy" decoding="async" height="40" />
            ))}
          </div>
        )}
      </section>
    )}

    <div class="cyber-cta">
      <a href="/tarifs" class="cyber-button" data-track="home_beta_details" style="text-decoration: none; display: inline-block;">Comprendre la bêta</a>
    </div>
  </div>

  <div
    id="brutalModeModal"
    class="modal-overlay brutal-modal-overlay"
    style="display: none;"
    role="dialog"
    aria-modal="true"
    aria-hidden="true"
    aria-labelledby="brutalModeModalTitle"
  >
    <div class="brutal-modal-container">
      <button
        class="brutal-modal-close"
        type="button"
        data-close-modal="brutalModeModal"
        aria-label="Fermer"
      >×</button>
      <div class="brutal-modal-content">
        <section class="brutal-hero">
          <div class="brutal-hero-bg"></div>
          <div class="brutal-hero-content">
            <p class="brutal-hero-eyebrow">Diagnostic terrain</p>
            <h2 id="brutalModeModalTitle" class="brutal-hero-title">
              Les irritants qui ralentissent<br>
              le suivi étudiant au quotidien
            </h2>
            <p class="brutal-hero-subtitle">
              Avant de parler solution, il faut nommer le problème : informations dispersées,
              exports fragiles, preuves difficiles à retrouver et manque de lecture partagée.
            </p>
          </div>
        </section>

        <section class="brutal-section brutal-problems-section">
          <h2 class="brutal-section-title">Les irritants que tout le monde connaît</h2>
          <p class="brutal-section-subtitle">Ceux qu'on finit par accepter, alors qu'ils ralentissent toute l'équipe.</p>

          <div class="brutal-problems-grid">
            <div class="brutal-problem-card">
              <div class="brutal-problem-icon">INFO</div>
              <h3 class="brutal-problem-title">Information trop dispersée</h3>
              <p class="brutal-problem-desc">
                Onglets imbriqués, libellés techniques, actions cachées : le moindre export peut demander trop de contexte.
              </p>
              <div class="brutal-problem-quote">
                "Je sais que l'info existe quelque part, mais je ne sais plus dans quel écran."
              </div>
            </div>

            <div class="brutal-problem-card">
              <div class="brutal-problem-icon">DOC</div>
              <h3 class="brutal-problem-title">Bulletins longs à préparer</h3>
              <p class="brutal-problem-desc">
                Entre imports, vérifications, exports et corrections, produire un bulletin peut vite devenir une suite de manipulations fragiles.
              </p>
              <div class="brutal-problem-quote">
                "On a fini, mais il faut encore vérifier si tout est bien parti dans le bon fichier."
              </div>
            </div>

            <div class="brutal-problem-card">
              <div class="brutal-problem-icon">FLUX</div>
              <h3 class="brutal-problem-title">Tâches qui cassent le rythme</h3>
              <p class="brutal-problem-desc">
                Quand l'outil répond lentement ou force des détours, les équipes perdent le fil et reportent les mises à jour.
              </p>
              <div class="brutal-problem-quote">
                "Je le ferai plus tard, quand j'aurai le temps de tout rouvrir."
              </div>
            </div>

            <div class="brutal-problem-card">
              <div class="brutal-problem-icon">MOB</div>
              <h3 class="brutal-problem-title">Consultation terrain limitée</h3>
              <p class="brutal-problem-desc">
                Certains écrans restent pensés pour le poste fixe, alors que les équipes consultent aussi depuis un portable ou une tablette.
              </p>
              <div class="brutal-problem-quote">
                "Je voulais juste vérifier une absence avant un rendez-vous."
              </div>
            </div>

            <div class="brutal-problem-card">
              <div class="brutal-problem-icon">VUE</div>
              <h3 class="brutal-problem-title">Lecture étudiant incomplète</h3>
              <p class="brutal-problem-desc">
                Absences, notes, documents et commentaires vivent parfois dans des modules séparés, sans vraie lecture par étudiant.
              </p>
              <div class="brutal-problem-quote">
                "Il faut connaître le chemin exact, sinon on demande à quelqu'un."
              </div>
            </div>

            <div class="brutal-problem-card">
              <div class="brutal-problem-icon">UX</div>
              <h3 class="brutal-problem-title">Priorités peu visibles</h3>
              <p class="brutal-problem-desc">
                Un design peu hiérarchisé n'est pas seulement esthétique : il rend les priorités moins lisibles et fatigue les usages répétés.
              </p>
              <div class="brutal-problem-quote">
                "Je dois relire trois fois l'écran pour savoir ce qui est important."
              </div>
            </div>
          </div>

          <div style="text-align: center; margin-top: 40px;">
            <p style="font-size: 28px; color: #FF007F; font-weight: 700;">
              Si ça vous parle, Arrow mérite une démo.
            </p>
          </div>
        </section>

        <section class="brutal-section brutal-usp-section">
          <h2 class="brutal-section-title">Ce qu'Arrow veut rendre plus simple</h2>
          <p class="brutal-usp-intro">
            La bêta se concentre sur les usages les plus concrets : comprendre la situation d'un étudiant,
            retrouver les éléments utiles et partager une information fiable.
          </p>

          <div class="brutal-usp-grid">
            <div class="brutal-usp-card">
              <span class="brutal-usp-badge">Interface</span>
              <h3 class="brutal-usp-title">Interface plus lisible</h3>
              <p class="brutal-usp-desc">
                Une lecture moderne qui hiérarchise les informations utiles au lieu de tout mettre au même niveau.
              </p>
              <div class="brutal-usp-benefit">Navigation claire et logique</div>
              <div class="brutal-usp-benefit">Priorités visuelles plus nettes</div>
              <div class="brutal-usp-benefit">Design responsive travaillé</div>
              <div class="brutal-usp-benefit">Moins d'allers-retours inutiles</div>
            </div>

            <div class="brutal-usp-card">
              <span class="brutal-usp-badge">Performance</span>
              <h3 class="brutal-usp-title">Réactivité soignée</h3>
              <p class="brutal-usp-desc">
                Arrow vise des écrans légers et rapides, avec moins de frictions dans les tâches fréquentes.
              </p>
              <div class="brutal-usp-benefit">Pages pensées pour les usages répétés</div>
              <div class="brutal-usp-benefit">Moins de chargements intermédiaires</div>
              <div class="brutal-usp-benefit">Parcours plus directs</div>
              <div class="brutal-usp-benefit">Socle technique web moderne</div>
            </div>

            <div class="brutal-usp-card">
              <span class="brutal-usp-badge">Automation</span>
              <h3 class="brutal-usp-title">Bulletins plus cadrés</h3>
              <p class="brutal-usp-desc">
                La bêta aide à relier les résultats et les informations utiles pour préparer les bulletins plus proprement.
              </p>
              <div class="brutal-usp-benefit">Données regroupées au même endroit</div>
              <div class="brutal-usp-benefit">Lecture plus simple des résultats</div>
              <div class="brutal-usp-benefit">Préparation d'exports selon le périmètre</div>
              <div class="brutal-usp-benefit">Moins de ressaisie manuelle</div>
            </div>

            <div class="brutal-usp-card">
              <span class="brutal-usp-badge">Gestion</span>
              <h3 class="brutal-usp-title">Tout centralisé</h3>
              <p class="brutal-usp-desc">
                Étudiants, notes, absences, documents et commentaires utiles regroupés dans une vue cohérente.
              </p>
              <div class="brutal-usp-benefit">Vue étudiant plus complète</div>
              <div class="brutal-usp-benefit">Recherche et filtres selon le périmètre</div>
              <div class="brutal-usp-benefit">Vue unifiée par étudiant</div>
              <div class="brutal-usp-benefit">Commentaires et preuves mieux reliés</div>
            </div>

            <div class="brutal-usp-card">
              <span class="brutal-usp-badge">Mobile</span>
              <h3 class="brutal-usp-title">Consultation responsive</h3>
              <p class="brutal-usp-desc">
                Les écrans publics et les parcours clés sont pensés pour rester lisibles sur plusieurs tailles d'écran.
              </p>
              <div class="brutal-usp-benefit">Interface adaptative</div>
              <div class="brutal-usp-benefit">Utilisable sur smartphone/tablette</div>
              <div class="brutal-usp-benefit">Contrôles plus lisibles</div>
              <div class="brutal-usp-benefit">Priorité aux informations essentielles</div>
            </div>

            <div class="brutal-usp-card">
              <span class="brutal-usp-badge">Alternance</span>
              <h3 class="brutal-usp-title">Alternance à cadrer</h3>
              <p class="brutal-usp-desc">
                Les besoins liés à l'alternance peuvent être cadrés pendant la bêta pour prioriser les bons flux.
              </p>
              <div class="brutal-usp-benefit">Suivi des points clés à définir</div>
              <div class="brutal-usp-benefit">Documents et preuves mieux rangés</div>
              <div class="brutal-usp-benefit">Priorités terrain recueillies</div>
              <div class="brutal-usp-benefit">Évolutions possibles selon les retours</div>
            </div>
          </div>
        </section>

        <section class="brutal-section brutal-comparison-section">
          <h2 class="brutal-section-title">Le comparatif à vérifier en démo</h2>
          <p class="brutal-section-subtitle">Des promesses utiles seulement si elles tiennent dans votre contexte.</p>

          <div class="brutal-table-wrapper">
            <table class="brutal-comparison-table">
              <thead>
                <tr>
                  <th style="width: 35%;">Fonctionnalité</th>
                  <th style="width: 32.5%;">Suivi actuel</th>
                  <th style="width: 32.5%;">ARROW</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td class="brutal-feature-name">Temps de formation</td>
                  <td class="brutal-old-platform">
                    Souvent long quand les écrans sont dispersés
                    <span class="brutal-sarcasm">("Il faut connaître les bons chemins")</span>
                  </td>
                  <td class="brutal-arrow-platform">Prise en main à valider sur vos cas</td>
                </tr>
                <tr>
                  <td class="brutal-feature-name">Génération bulletins</td>
                  <td class="brutal-old-platform">
                    Manipulations manuelles et contrôles multiples
                    <span class="brutal-sarcasm">("Surtout quand les données changent")</span>
                  </td>
                  <td class="brutal-arrow-platform">Préparation plus cadrée selon périmètre</td>
                </tr>
                <tr>
                  <td class="brutal-feature-name">Interface utilisateur</td>
                  <td class="brutal-old-platform">
                    Écrans denses et peu hiérarchisés
                    <span class="brutal-sarcasm">("Tout est là, mais rien ne ressort")</span>
                  </td>
                  <td class="brutal-arrow-platform">Interface plus lisible et actuelle</td>
                </tr>
                <tr>
                  <td class="brutal-feature-name">Version mobile</td>
                  <td class="brutal-old-platform">
                    Consultation mobile souvent secondaire
                    <span class="brutal-sarcasm">("Pratique pour lire, moins pour agir")</span>
                  </td>
                  <td class="brutal-arrow-platform">Parcours responsive sur les écrans clés</td>
                </tr>
                <tr>
                  <td class="brutal-feature-name">Vitesse de chargement</td>
                  <td class="brutal-old-platform">
                    Temps de réponse variables selon les modules
                    <span class="brutal-sarcasm">("Et selon l'heure de la journée")</span>
                  </td>
                  <td class="brutal-arrow-platform">Réactivité à mesurer pendant la bêta</td>
                </tr>
                <tr>
                  <td class="brutal-feature-name">Gestion alternance</td>
                  <td class="brutal-old-platform">
                    Tableurs, documents et emails séparés
                    <span class="brutal-sarcasm">("Ça marche, jusqu'au prochain oubli")</span>
                  </td>
                  <td class="brutal-arrow-platform">Besoins à cadrer dans la bêta</td>
                </tr>
                <tr>
                  <td class="brutal-feature-name">Support technique</td>
                  <td class="brutal-old-platform">
                    Circuit de support parfois difficile à suivre
                    <span class="brutal-sarcasm">("On ne sait plus où en est la demande")</span>
                  </td>
                  <td class="brutal-arrow-platform">Échange direct pendant la bêta</td>
                </tr>
                <tr>
                  <td class="brutal-feature-name">Mises à jour</td>
                  <td class="brutal-old-platform">
                    Évolutions lentes ou peu visibles
                    <span class="brutal-sarcasm">("On s'adapte en attendant")</span>
                  </td>
                  <td class="brutal-arrow-platform">Itérations guidées par les retours</td>
                </tr>
              </tbody>
            </table>
          </div>
        </section>

        <section class="brutal-section brutal-testimonials-section">
          <h2 class="brutal-section-title">Ce qu'ils disent</h2>
          <p class="brutal-section-subtitle">Avant/Après Arrow</p>

          <div class="brutal-testimonials-grid">
            <div class="brutal-testimonial brutal-testimonial-before">
              <div class="brutal-testimonial-type">Avant Arrow</div>
              <p class="brutal-testimonial-quote">
                "Je perdais trop de temps à recouper les mêmes informations entre plusieurs outils."
              </p>
              <p class="brutal-testimonial-author">— Exemple de situation, direction pédagogique</p>
            </div>

            <div class="brutal-testimonial">
              <div class="brutal-testimonial-type">Avec Arrow</div>
              <p class="brutal-testimonial-quote">
                "Avec une vue par étudiant, l'équipe sait plus vite quoi regarder et quoi partager."
              </p>
              <p class="brutal-testimonial-author">— Objectif de la bêta Arrow</p>
            </div>

            <div class="brutal-testimonial brutal-testimonial-before">
              <div class="brutal-testimonial-type">Avant Arrow</div>
              <p class="brutal-testimonial-quote">
                "Quand une personne arrive dans l'équipe, elle doit souvent apprendre les habitudes avant l'outil."
              </p>
              <p class="brutal-testimonial-author">— Exemple de situation, équipe scolarité</p>
            </div>

            <div class="brutal-testimonial">
